 "hints": {
  "etre": [
   "je suis – Ich bin.",
   "tu es – Du bist. Nur zwei Buchstaben: e-s.",
   "il / elle / on est – Er, sie, man ist. Das gilt auch für Namen: Léa est …",
   "nous sommes – Wir sind. Merke das doppelte m.",
   "vous êtes – Ihr seid / Sie sind. Der Dach-Akzent ê ist Pflicht, „vous êtez“ gibt es nicht.",
   "ils / elles sont – Sie sind. Alle Mehrzahl-Subjekte (Léa et Tom) brauchen sont."
  ],
  "avoir": [
   "j'ai – Ich habe. Vor einem Vokal wird je zu j'.",
   "tu as – Du hast.",
   "il / elle / on a – Er, sie hat. Das Alter sagt man mit avoir: Il a onze ans.",
   "nous avons – Wir haben.",
   "vous avez – Ihr habt / Sie haben.",
   "ils / elles ont – Sie haben (Mehrzahl)."
  ],
  "aller": [
   "je vais – Ich gehe. Es heißt nicht „je vas“.",
   "tu vas – Du gehst.",
   "il / elle / on va – Er, sie geht. Nur zwei Buchstaben, kein s.",
   "nous allons – Wir gehen. Hier taucht der Stamm all- wieder auf.",
   "vous allez – Ihr geht / Sie gehen.",
   "ils / elles vont – Sie gehen. Wie ils font und ils sont: Endung -ont."
  ],
  "faire": [
   "je fais – Ich mache.",
   "tu fais – Du machst. Klingt und schreibt sich wie je fais.",
   "il / elle / on fait – Er, sie macht. Hier steht ein t am Ende.",
   "nous faisons – Wir machen.",
   "vous faites – Ihr macht / Sie machen. Nicht „faisez“! Wie vous êtes eine Ausnahme auf -tes.",
   "ils / elles font – Sie machen. Eine der vier -ont-Formen."
  ]
 }
}
