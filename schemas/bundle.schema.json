{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foued611.github.io/lernapp-sira/schemas/bundle.schema.json",
  "title": "Lernwerkstatt-Inhaltspaket",
  "description": "Alles, was eine Lern-App an Inhalt braucht: Seiten, Lektionen, Trophäen und Aufgabendaten. Dieselbe Form liefert content/<id>/*.json heute und eine Datenbank-API später.",
  "type": "object",
  "required": ["manifest", "lessons", "badges"],
  "additionalProperties": false,
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "lessons": { "$ref": "#/$defs/lessons" },
    "badges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/badge" } },
    "data": { "type": "object", "description": "Aufgabendaten. Form bestimmt die Logik der jeweiligen App (apps/<name>/logic.js)." }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "klasse": { "type": "integer", "minimum": 5, "maximum": 13 },
    "text": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "manifest": {
      "type": "object",
      "required": ["schema", "id", "title", "greeting", "intro", "units"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "greeting": { "$ref": "#/$defs/text" },
        "intro": { "$ref": "#/$defs/text" },
        "catalog": {
          "type": "object",
          "description": "Eintrag auf der Startseite. Fehlt das Feld, erscheint die App dort nicht (z. B. die Vorlage).",
          "required": ["fach", "klassen", "subject", "desc", "order"],
          "additionalProperties": false,
          "properties": {
            "fach": { "$ref": "#/$defs/id", "description": "Feste Kennung des Fachs. Apps eines Fachs stehen auf der Startseite zusammen." },
            "klassen": { "type": "array", "minItems": 1, "uniqueItems": true, "description": "Klassen, in denen die App auf der Startseite steht.", "items": { "$ref": "#/$defs/klasse" } },
            "lehrwerk": { "$ref": "#/$defs/text" },
            "subject": { "$ref": "#/$defs/text" },
            "desc": { "$ref": "#/$defs/text" },
            "order": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["live", "soon"] }
          }
        },
        "bossTitle": { "$ref": "#/$defs/text" },
        "inputChars": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2 } },
        "words": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "praise": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
            "resultTitles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/text" } },
            "blitzTitle": { "$ref": "#/$defs/text" },
            "levelTitles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "tracks": {
          "type": "object",
          "description": "Lernstränge, z. B. lrs = LRS-Förderung. Seiten und Material verweisen per track darauf.",
          "additionalProperties": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": { "label": { "$ref": "#/$defs/text" }, "desc": { "$ref": "#/$defs/text" } } }
        },
        "groups": {
          "type": "array",
          "description": "Kapitel des Lernpfads in Anzeige-Reihenfolge. Seiten verweisen per group auf die id. Die id ist fest, der Titel darf sich ändern.",
          "items": { "type": "object", "required": ["id", "title"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "klasse": { "$ref": "#/$defs/klasse" } } }
        },
        "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } },
        "notes": {
          "type": "object",
          "description": "Merkzettel je Seite: Liste aus [Überschrift, Text]",
          "additionalProperties": { "type": "array", "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/text" }], "minItems": 2, "maxItems": 2 } }
        },
        "resources": {
          "type": "array",
          "description": "Material zum Öffnen oder Ausdrucken (z. B. PDF). href ist ein relativer Pfad zur index.html der App, ohne Schema, ohne führenden Slash, ohne ..",
          "items": {
            "type": "object",
            "required": ["title", "href"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/text" },
              "desc": { "$ref": "#/$defs/text" },
              "track": { "$ref": "#/$defs/id" },
              "href": { "type": "string", "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?!.*\\.\\.)[^\\s\"'<>]+$" }
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "title", "de", "ic", "color", "card"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "de": { "$ref": "#/$defs/text" },
        "ic": { "$ref": "#/$defs/text" },
        "color": { "$ref": "#/$defs/color" },
        "track": { "$ref": "#/$defs/id" },
        "group": { "$ref": "#/$defs/id" },
        "needs": { "type": "array", "uniqueItems": true, "description": "Seiten derselben App, auf denen diese aufbaut. Nur ein Hinweis, nichts wird gesperrt.", "items": { "$ref": "#/$defs/id" } },
        "card": { "type": "object", "required": ["name", "fact"], "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/text" }, "fact": { "$ref": "#/$defs/text" } } }
      }
    },
    "lessons": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/lesson" } },
    "lesson": {
      "type": "object",
      "required": ["goal", "tldr", "analogy", "figure", "steps", "pitfall", "rule", "check"],
      "additionalProperties": false,
      "properties": {
        "goal": { "$ref": "#/$defs/text" },
        "tldr": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
        "analogy": { "type": "object", "required": ["title", "html"], "additionalProperties": false, "properties": { "title": { "$ref": "#/$defs/text" }, "html": { "$ref": "#/$defs/text" } } },
        "figure": {
          "type": "object",
          "required": ["caption"],
          "properties": {
            "caption": { "$ref": "#/$defs/text" },
            "diagram": { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }, "args": { "type": "array" } } },
            "svg": { "$ref": "#/$defs/text" }
          },
          "oneOf": [{ "required": ["diagram"] }, { "required": ["svg"] }]
        },
        "steps": { "type": "object", "required": ["title", "items"], "additionalProperties": false, "properties": { "title": { "$ref": "#/$defs/text" }, "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } } } },
        "pitfall": { "type": "object", "required": ["html"], "additionalProperties": false, "properties": { "html": { "$ref": "#/$defs/text" } } },
        "rule": { "$ref": "#/$defs/text" },
        "check": {
          "type": "object",
          "required": ["q", "options", "answer", "why"],
          "additionalProperties": false,
          "properties": {
            "q": { "$ref": "#/$defs/text" },
            "options": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "html"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/text" }, "html": { "$ref": "#/$defs/text" } } } },
            "answer": { "$ref": "#/$defs/text" },
            "why": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "badge": {
      "type": "object",
      "required": ["id", "n", "d", "rule"],
      "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "n": { "$ref": "#/$defs/text" }, "d": { "$ref": "#/$defs/text" }, "rule": { "$ref": "#/$defs/rule" } }
    },
    "rule": {
      "description": "Deklarative Trophäen-Bedingung, ausgewertet von core/js/rules.js",
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "enum": ["anyUnit", "perfectRound", "boss"] } } },
        { "type": "object", "required": ["type", "id"], "additionalProperties": false, "properties": { "type": { "const": "unit" }, "id": { "$ref": "#/$defs/id" }, "stars": { "type": "integer", "minimum": 1, "maximum": 3 } } },
        { "type": "object", "required": ["type", "ids"], "additionalProperties": false, "properties": { "type": { "const": "units" }, "ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } },
        { "type": "object", "required": ["type", "min"], "additionalProperties": false, "properties": { "type": { "const": "combo" }, "min": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "required": ["type", "min"], "additionalProperties": false, "properties": { "type": { "const": "blitz" }, "min": { "type": "integer", "minimum": 1 }, "maxWrong": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "required": ["type", "unit", "by"], "additionalProperties": false, "properties": { "type": { "const": "improved" }, "unit": { "$ref": "#/$defs/id" }, "by": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } },
        { "type": "object", "required": ["type", "min"], "additionalProperties": false, "properties": { "type": { "const": "retryRecovered" }, "min": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "required": ["type", "count"], "additionalProperties": false, "properties": { "type": { "const": "refresh" }, "count": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "required": ["type", "days"], "additionalProperties": false, "properties": { "type": { "const": "streak" }, "days": { "type": "integer", "minimum": 2 } } },
        { "type": "object", "required": ["type", "rules"], "additionalProperties": false, "properties": { "type": { "enum": ["all", "any"] }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } } } }
      ]
    }
  }
}
